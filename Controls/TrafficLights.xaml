<UserControl x:Class="PDFEditor.Controls.TrafficLights"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             HorizontalAlignment="Left"
             VerticalAlignment="Center"
             Background="Transparent">

    <UserControl.Resources>

        <!-- ============================================================
             Un feu tricolore : disque de 12 px, liseré interne discret,
             glyphe revele au survol du groupe (comme sur macOS).
             Le disque prend la couleur de Background ; Tag porte la
             geometrie du glyphe (boite 24 x 24).
             ============================================================ -->
        <Style x:Key="TrafficLightButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Fill="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Ellipse x:Name="Ring" Stroke="#14000000" StrokeThickness="1" Margin="0.5"/>
                            <Viewbox x:Name="GlyphBox" Width="12" Height="12" Opacity="0"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Fill="{DynamicResource TrafficGlyph}"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <ControlTemplate.Triggers>

                            <!-- Fenetre inactive : les trois pastilles deviennent grises. -->
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                                <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource TrafficInactive}"/>
                            </DataTrigger>

                            <!-- Survol du groupe : les glyphes apparaissent. -->
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}" Value="True">
                                <Setter TargetName="GlyphBox" Property="Opacity" Value="1"/>
                            </DataTrigger>

                            <!-- Fenetre inactive mais survolee : les couleurs reviennent. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Disc" Property="Fill" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </MultiDataTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.62"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- 3 pastilles de 12 px espacees de 8 px -->
    <StackPanel x:Name="LightsPanel"
                Orientation="Horizontal"
                Background="Transparent"
                VerticalAlignment="Center">

        <Button x:Name="CloseButton"
                Style="{StaticResource TrafficLightButton}"
                Background="{DynamicResource TrafficRed}"
                Tag="{DynamicResource Icon.Close}"
                Margin="0,0,8,0"
                ToolTip="Fermer"
                Click="OnCloseClick"/>

        <Button x:Name="MinimizeButton"
                Style="{StaticResource TrafficLightButton}"
                Background="{DynamicResource TrafficYellow}"
                Tag="{DynamicResource Icon.Minimize}"
                Margin="0,0,8,0"
                ToolTip="Réduire"
                Click="OnMinimizeClick"/>

        <Button x:Name="ZoomButton"
                Style="{StaticResource TrafficLightButton}"
                Background="{DynamicResource TrafficGreen}"
                Tag="{DynamicResource Icon.Zoom}"
                ToolTip="Agrandir"
                Click="OnZoomClick"/>

    </StackPanel>
</UserControl>
