<Window x:Class="PDFEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PDFEditor.Views"
        xmlns:doc="clr-namespace:PDFEditor.Views.Document"
        xmlns:conv="clr-namespace:PDFEditor.Converters"
        Title="{Binding WindowTitle}"
        Width="1320"
        Height="860"
        MinWidth="760"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Barre de titre dessinee par l'application (feux tricolores) ;
         seule la bordure de redimensionnement reste geree par Windows. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <!-- ================================================================
         Grille maitresse
             ligne 0 : barre de titre et d'outils (52 px)
             ligne 1 : barre d'annotation (44 px, masquable)
             ligne 2 : [barre laterale][|][document][|][inspecteur]
         ================================================================ -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="212" MaxWidth="420"/>
            <ColumnDefinition x:Name="SidebarSplitterColumn" Width="1"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition x:Name="InspectorSplitterColumn" Width="1"/>
            <ColumnDefinition x:Name="InspectorColumn" Width="276" MaxWidth="440"/>
        </Grid.ColumnDefinitions>

        <views:MarkupBarView x:Name="MarkupBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"/>

        <Border x:Name="SidebarHost"
                Grid.Row="2"
                Grid.Column="0"
                ClipToBounds="True"
                Background="{DynamicResource SidebarBg}">
            <views:SidebarView x:Name="Sidebar"/>
        </Border>

        <GridSplitter x:Name="SidebarSplitter"
                      Grid.Row="2"
                      Grid.Column="1"
                      Style="{StaticResource PaneSplitter}"
                      ToolTip="Redimensionner la barre latérale"/>

        <Grid Grid.Row="2" Grid.Column="2" ClipToBounds="True">
            <doc:DocumentView x:Name="DocumentView" Visibility="Collapsed"/>
            <views:WelcomeView x:Name="Welcome"/>
        </Grid>

        <GridSplitter x:Name="InspectorSplitter"
                      Grid.Row="2"
                      Grid.Column="3"
                      Style="{StaticResource PaneSplitter}"
                      ToolTip="Redimensionner l’inspecteur"/>

        <Border x:Name="InspectorHost"
                Grid.Row="2"
                Grid.Column="4"
                ClipToBounds="True"
                Background="{DynamicResource InspectorBg}">
            <views:InspectorView x:Name="Inspector"/>
        </Border>

        <!-- Placee en dernier : dessinee au-dessus, recoit les clics de deplacement. -->
        <views:TitleBarView x:Name="TitleBar"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            SidebarWidth="{Binding ActualWidth, ElementName=SidebarHost}"/>

        <!-- ============================== Occupation ================== -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Background="#01000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Padding="20,14"
                    BorderThickness="1"
                    Background="{DynamicResource HudBg}"
                    BorderBrush="{DynamicResource PopoverBorderBrush}"
                    Effect="{DynamicResource HudShadow}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 9,1 A 8,8 0 1 1 1,9"
                          Width="18" Height="18"
                          Stretch="None"
                          StrokeThickness="2.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stroke="{DynamicResource AccentYellow}"
                          RenderTransformOrigin="0.5,0.5"
                          VerticalAlignment="Center">
                        <Path.RenderTransform>
                            <RotateTransform/>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                    <TextBlock Text="{Binding BusyMessage}"
                               Margin="12,0,0,0"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
