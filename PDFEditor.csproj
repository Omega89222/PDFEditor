<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Cible Windows 10 SDK : donne acces a Windows.Media.Ocr (reconnaissance de texte). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PDFEditor</RootNamespace>
    <AssemblyName>PDFEditor</AssemblyName>
    <Product>Éditeur PDF</Product>
    <AssemblyTitle>Éditeur PDF</AssemblyTitle>
    <Version>1.0.0</Version>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <!-- PDFium est une bibliotheque native : on cible x64 uniquement. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Icone generee par l'application elle-meme (option make-icon, voir App.xaml.cs). -->
    <ApplicationIcon>PDFEditor.ico</ApplicationIcon>
    <!-- Le programme d'installation est un projet distinct ; les sorties de publication ne sont pas des sources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Installer\**;artifacts\**;dist\**;docs\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Rendu, texte, edition du contenu, formulaires : PDFium (moteur de Chrome). -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="155.0.8044" />
    <!-- Metadonnees et chiffrement par mot de passe. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

</Project>
