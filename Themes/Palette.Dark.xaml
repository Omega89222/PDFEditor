<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================ -->
    <!-- Palette SOMBRE (reprise de l'app Notes, theme sombre)        -->
    <!-- ============================================================ -->

    <!-- Fonds -->
    <SolidColorBrush x:Key="WindowBg" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#FF262625"/>
    <SolidColorBrush x:Key="ListBg" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="EditorBg" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="CanvasBg" Color="#FF141414"/>
    <SolidColorBrush x:Key="InspectorBg" Color="#FF232322"/>
    <SolidColorBrush x:Key="MarkupBarBg" Color="#FF222221"/>

    <!-- Textes -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF98989D"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#FF6E6E73"/>
    <SolidColorBrush x:Key="TextPlaceholder" Color="#FF737378"/>
    <SolidColorBrush x:Key="TextOnSelection" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FF1C1C1E"/>

    <!-- Accent et selections -->
    <SolidColorBrush x:Key="AccentYellow" Color="#FFFFD60A"/>
    <SolidColorBrush x:Key="AccentDeep" Color="#FFFFD60A"/>
    <SolidColorBrush x:Key="SidebarSelectionBg" Color="#FF4A3F18"/>
    <SolidColorBrush x:Key="SidebarSelectionInactiveBg" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="ListSelectionBg" Color="#FF574A1C"/>
    <SolidColorBrush x:Key="ListSelectionInactiveBg" Color="#FF333335"/>

    <!-- Separateurs et etats -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="ListSeparatorBrush" Color="#FF323234"/>
    <SolidColorBrush x:Key="HoverBg" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PressedBg" Color="#20FFFFFF"/>

    <!-- Icones -->
    <SolidColorBrush x:Key="IconBrush" Color="#FF98989D"/>
    <SolidColorBrush x:Key="IconActiveBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="IconDisabledBrush" Color="#FF55555A"/>
    <SolidColorBrush x:Key="FolderIconBrush" Color="#FFC9B36B"/>

    <!-- Popovers / champs / scrollbars -->
    <SolidColorBrush x:Key="PopoverBg" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="PopoverBorderBrush" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="SearchFieldBg" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="FieldBg" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#FF48484A"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="HudBg" Color="#F22C2C2E"/>
    <SolidColorBrush x:Key="SegmentTrackBg" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="SegmentSelectedBg" Color="#FF636366"/>
    <SolidColorBrush x:Key="SwitchOffBg" Color="#FF48484A"/>
    <SolidColorBrush x:Key="CardBg" Color="#FF2A2A2B"/>
    <SolidColorBrush x:Key="DropZoneBrush" Color="#FF4A4A4C"/>

    <!-- Feux tricolores -->
    <SolidColorBrush x:Key="TrafficRed" Color="#FFFF5F57"/>
    <SolidColorBrush x:Key="TrafficYellow" Color="#FFFEBC2E"/>
    <SolidColorBrush x:Key="TrafficGreen" Color="#FF28C840"/>
    <SolidColorBrush x:Key="TrafficInactive" Color="#FF4A4A4C"/>
    <SolidColorBrush x:Key="TrafficGlyph" Color="#90000000"/>

    <!-- Document -->
    <SolidColorBrush x:Key="PageBorderBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#55FFD60A"/>
    <SolidColorBrush x:Key="SearchHitBrush" Color="#5CFFD60A"/>
    <SolidColorBrush x:Key="SearchCurrentBrush" Color="#8CFF9F0A"/>
    <SolidColorBrush x:Key="SelectionOutlineBrush" Color="#FFFFD60A"/>
    <SolidColorBrush x:Key="HandleFillBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="HoverOutlineBrush" Color="#B3FFD60A"/>
    <SolidColorBrush x:Key="ThumbSelectionBrush" Color="#FFFFD60A"/>

    <!-- Etats -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF30D158"/>

    <!-- ============================================================ -->
    <!-- Metriques, polices et effets                                 -->
    <!-- ============================================================ -->

    <sys:Double x:Key="ToolbarHeight">52</sys:Double>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <CornerRadius x:Key="RowRadius">6</CornerRadius>

    <DropShadowEffect x:Key="PopoverShadow" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.40" Color="#000000"/>
    <DropShadowEffect x:Key="HudShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#000000"/>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.30" Color="#000000"/>

</ResourceDictionary>
