<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- La configuration NuGet de l'utilisateur ne declare aucune source :
       le projet apporte la sienne. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
