<Application x:Class="PDFEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">

    <!-- Pas de StartupUri : les fenetres sont construites dans App.OnStartup,
         une fois les reglages charges et le theme applique. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- INDEX 0 : palette de couleurs.
                     ThemeManager.Apply remplace CETTE entree (et elle seule)
                     par Themes/Palette.Dark.xaml pour passer en mode sombre. -->
                <ResourceDictionary Source="Themes/Palette.xaml"/>

                <!-- Geometries d'icones (boite 24 x 24) -->
                <ResourceDictionary Source="Themes/Icons.xaml"/>

                <!-- Styles de controles facon macOS -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
