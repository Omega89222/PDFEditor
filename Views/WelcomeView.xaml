<UserControl x:Class="PDFEditor.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:PDFEditor.Controls"
             xmlns:conv="clr-namespace:PDFEditor.Converters"
             xmlns:vm="clr-namespace:PDFEditor.ViewModels"
             x:Name="Root"
             AllowDrop="True"
             FontFamily="{DynamicResource UiFont}"
             Background="{DynamicResource CanvasBg}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Grande action de l'ecran d'accueil -->
        <Style x:Key="WelcomeAction" TargetType="Button">
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="12"
                                BorderThickness="1"
                                Background="{DynamicResource PopoverBg}"
                                BorderBrush="{DynamicResource PopoverBorderBrush}"
                                Effect="{DynamicResource CardShadow}">
                            <StackPanel VerticalAlignment="Center">
                                <Path Data="{Binding Path=(ctrl:IconHost.Geometry), RelativeSource={RelativeSource TemplatedParent}}"
                                      Width="26" Height="26"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Fill="{DynamicResource AccentDeep}"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  Margin="8,10,8,0"
                                                  TextElement.FontSize="12.5"
                                                  TextElement.Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentYellow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ligne de fichier recent -->
        <Style x:Key="RecentItem" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource MacScrollViewer}">
        <StackPanel MaxWidth="640" Margin="36,54,36,40" HorizontalAlignment="Center">

            <ContentControl x:Name="IconHost" Width="104" Height="104" HorizontalAlignment="Center" Focusable="False"/>

            <TextBlock Text="Éditeur PDF"
                       FontFamily="{DynamicResource UiFontDisplay}"
                       FontSize="30"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,4"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Lisez, annotez, remplissez, signez et réorganisez vos documents PDF."
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>

            <UniformGrid Columns="4" Margin="-6,30,-6,0">
                <Button Style="{StaticResource WelcomeAction}" ctrl:IconHost.Geometry="{StaticResource Icon.Open}" Content="Ouvrir un PDF…" Command="{Binding OpenCommand}"/>
                <Button Style="{StaticResource WelcomeAction}" ctrl:IconHost.Geometry="{StaticResource Icon.InsertPage}" Content="Document vierge" Command="{Binding CreateBlankCommand}"/>
                <Button Style="{StaticResource WelcomeAction}" ctrl:IconHost.Geometry="{StaticResource Icon.Photo}" Content="À partir d’images" Command="{Binding CreateFromImagesCommand}"/>
                <Button Style="{StaticResource WelcomeAction}" ctrl:IconHost.Geometry="{StaticResource Icon.Pages}" Content="Fusionner des PDF" Command="{Binding MergeCommand}"/>
            </UniformGrid>

            <DockPanel Margin="4,34,4,6" Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Content="Effacer" Style="{StaticResource MacLinkButton}" Command="{Binding ClearRecentCommand}"/>
                <TextBlock Text="RÉCENTS" Style="{StaticResource SectionHeader}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Style="{StaticResource CardBorder}" Padding="6"
                    Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding RecentFiles}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RecentFileItem}">
                            <Button Style="{StaticResource RecentItem}"
                                    ToolTip="{Binding Path}"
                                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding Path}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Retirer de la liste"
                                                  Command="{Binding PlacementTarget.Tag.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding Path}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Tag>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                </Button.Tag>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource Icon.Document}"
                                          Width="24" Height="24"
                                          Stretch="Uniform"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          Fill="{DynamicResource FolderIconBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Folder}"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextTertiary}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Detail}"
                                               FontSize="11.5"
                                               Margin="14,0,4,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Margin="0,28,0,0" Height="74">
                <Rectangle x:Name="DropZone"
                           RadiusX="14" RadiusY="14"
                           StrokeThickness="1.5"
                           StrokeDashArray="5 4"
                           Stroke="{DynamicResource DropZoneBrush}"/>
                <TextBlock x:Name="DropText"
                           Text="Déposez un fichier PDF ici pour l’ouvrir"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource TextTertiary}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
