<UserControl x:Class="PDFEditor.Views.Document.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:PDFEditor.Controls"
             x:Name="Root"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             AllowDrop="True"
             Background="{DynamicResource CanvasBg}"
             UseLayoutRounding="True">

    <Grid>

        <!-- Surface defilante : le canevas des pages est cree par le code. -->
        <ScrollViewer x:Name="Scroller"
                      Style="{StaticResource MacScrollViewer}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="Both"
                      CanContentScroll="False"
                      Focusable="False"/>

        <!-- ============================================================
             HUD flottant : page courante et zoom (apparait au survol).
             ============================================================ -->
        <Border x:Name="Hud"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,22"
                Padding="5,4"
                CornerRadius="11"
                Opacity="0"
                IsHitTestVisible="False"
                Background="{DynamicResource HudBg}"
                BorderBrush="{DynamicResource PopoverBorderBrush}"
                BorderThickness="1"
                Effect="{DynamicResource HudShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource HudIconButton}"
                        ctrl:IconHost.Geometry="{StaticResource Icon.ChevronUp}"
                        ToolTip="Page précédente"
                        Command="{Binding PreviousPageCommand}"/>
                <Button Style="{StaticResource HudIconButton}"
                        ctrl:IconHost.Geometry="{StaticResource Icon.ChevronDown}"
                        ToolTip="Page suivante"
                        Command="{Binding NextPageCommand}"/>

                <TextBox x:Name="PageNumberBox"
                         Style="{StaticResource MacTextBox}"
                         Width="42"
                         Height="22"
                         MinHeight="22"
                         Padding="2,0"
                         Margin="6,0,0,0"
                         FontSize="12"
                         HorizontalContentAlignment="Center"
                         ToolTip="Aller à la page"/>
                <TextBlock x:Name="PageCountText"
                           Margin="7,0,10,0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"/>

                <Border Style="{StaticResource ToolbarDivider}" Height="16" Margin="0,0,4,0"/>

                <Button Style="{StaticResource HudIconButton}"
                        ctrl:IconHost.Geometry="{StaticResource Icon.Minus}"
                        ToolTip="Zoom arrière"
                        Command="{Binding ZoomOutCommand}"/>
                <TextBlock x:Name="ZoomText"
                           Width="48"
                           FontSize="12"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"/>
                <Button Style="{StaticResource HudIconButton}"
                        ctrl:IconHost.Geometry="{StaticResource Icon.Plus}"
                        ToolTip="Zoom avant"
                        Command="{Binding ZoomInCommand}"/>
            </StackPanel>
        </Border>

        <!-- Indication de depot de fichiers -->
        <Border x:Name="DropOverlay"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Margin="14"
                CornerRadius="14"
                BorderThickness="2"
                BorderBrush="{DynamicResource AccentYellow}"
                Background="#12FFCC00">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Padding="18,10"
                    Background="{DynamicResource HudBg}"
                    Effect="{DynamicResource HudShadow}">
                <TextBlock x:Name="DropText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </Border>
        </Border>

    </Grid>
</UserControl>
