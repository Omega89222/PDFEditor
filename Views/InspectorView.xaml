<UserControl x:Class="PDFEditor.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:PDFEditor.Controls"
             xmlns:conv="clr-namespace:PDFEditor.Converters"
             x:Name="Root"
             Focusable="False"
             FontFamily="{DynamicResource UiFont}"
             Background="{DynamicResource InspectorBg}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityInverse" Invert="True"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <conv:NumberConverter x:Key="Number"/>
        <conv:PercentConverter x:Key="Percent"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>

        <Style x:Key="InspectorCard" TargetType="Border">
            <Setter Property="Margin" Value="12,0,12,10"/>
            <Setter Property="Padding" Value="12,10,12,12"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PopoverBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PopoverBorderBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="84"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="SmallField" TargetType="TextBox" BasedOn="{StaticResource MacTextBox}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource MacScrollViewer}" Padding="0,6,0,16">
        <StackPanel>

            <!-- ============================================================
                 Annotation selectionnee
                 ============================================================ -->
            <StackPanel Visibility="{Binding Document.HasSelection, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">

                <TextBlock Text="ANNOTATION" Style="{StaticResource SectionHeader}" Margin="24,4,12,6"/>

                <Border Style="{StaticResource InspectorCard}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarIconButton}"
                                ctrl:IconHost.Geometry="{StaticResource Icon.Trash}"
                                ctrl:IconHost.Size="15"
                                ToolTip="Supprimer (Suppr)"
                                Command="{Binding DeleteCommand}"/>
                        <Path x:Name="SelectionIcon"
                              DockPanel.Dock="Left"
                              Width="20" Height="20"
                              Stretch="Uniform"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource AccentDeep}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Document.SelectedAnnotation.TypeName}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Document.SelectedAnnotation.Author}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Style -->
                <Border Style="{StaticResource InspectorCard}">
                    <StackPanel>
                        <TextBlock Text="STYLE" Style="{StaticResource SectionHeader}"/>

                        <DockPanel Style="{StaticResource Row}" Visibility="{Binding Document.SelectedAnnotation.HasStrokeStyle, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="Couleur" Style="{StaticResource RowLabel}"/>
                            <ctrl:ColorPickerButton HorizontalAlignment="Left" SelectedColor="{Binding Document.StyleStrokeColor}"/>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Row}" Visibility="{Binding Document.SelectedAnnotation.HasFillStyle, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="Remplissage" Style="{StaticResource RowLabel}"/>
                            <ctrl:ColorPickerButton HorizontalAlignment="Left" AllowTransparent="True" SelectedColor="{Binding Document.StyleFillColor}"/>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Row}" Visibility="{Binding Document.SelectedAnnotation.HasWidthStyle, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="Épaisseur" Style="{StaticResource RowLabel}"/>
                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding Document.StyleStrokeWidth, Converter={StaticResource Number}, ConverterParameter=1}"/>
                            <Slider Style="{StaticResource MacSlider}" Minimum="0" Maximum="24" SmallChange="0.5" LargeChange="2"
                                    Value="{Binding Document.StyleStrokeWidth}"/>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Row}" Visibility="{Binding Document.SelectedAnnotation.HasOpacityStyle, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="Opacité" Style="{StaticResource RowLabel}"/>
                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding Document.StyleOpacity, Converter={StaticResource Percent}}"/>
                            <Slider Style="{StaticResource MacSlider}" Minimum="0.05" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding Document.StyleOpacity}"/>
                        </DockPanel>

                        <ToggleButton Style="{StaticResource MacSwitch}" Content="Pointillés" FontSize="12" Margin="0,8,0,0"
                                      IsChecked="{Binding Document.StyleDashed}"
                                      Visibility="{Binding Document.SelectedAnnotation.HasDashStyle, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>
                    </StackPanel>
                </Border>

                <!-- Texte -->
                <Border Style="{StaticResource InspectorCard}"
                        Visibility="{Binding Document.SelectedAnnotation.HasTextStyle, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="TEXTE" Style="{StaticResource SectionHeader}"/>
                        <ComboBox Style="{StaticResource MacComboBox}"
                                  ItemsSource="{Binding FontFamilies}"
                                  SelectedItem="{Binding Document.StyleFontFamily}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource PopoverSegmentButton}" ctrl:IconHost.Geometry="{StaticResource Icon.Bold}" Margin="3,0,0,0" ToolTip="Gras" IsChecked="{Binding Document.StyleBold}"/>
                                <ToggleButton Style="{StaticResource PopoverSegmentButton}" ctrl:IconHost.Geometry="{StaticResource Icon.Italic}" Margin="3,0,0,0" ToolTip="Italique" IsChecked="{Binding Document.StyleItalic}"/>
                                <ToggleButton Style="{StaticResource PopoverSegmentButton}" ctrl:IconHost.Geometry="{StaticResource Icon.Underline}" Margin="3,0,0,0" ToolTip="Souligné" IsChecked="{Binding Document.StyleUnderline}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="FontSizeField" Style="{StaticResource SmallField}" Width="52" HorizontalContentAlignment="Right"
                                         Text="{Binding Document.StyleFontSize, Converter={StaticResource Number}, ConverterParameter=1, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="pt" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource SegmentTrack}" Margin="0,8,0,0">
                            <UniformGrid Rows="1">
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="InspectorAlign" ctrl:IconHost.Geometry="{StaticResource Icon.AlignLeft}" ToolTip="Aligner à gauche"
                                             IsChecked="{Binding Document.StyleAlignment, Converter={StaticResource EnumEquals}, ConverterParameter=Left}"/>
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="InspectorAlign" ctrl:IconHost.Geometry="{StaticResource Icon.AlignCenter}" ToolTip="Centrer"
                                             IsChecked="{Binding Document.StyleAlignment, Converter={StaticResource EnumEquals}, ConverterParameter=Center}"/>
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="InspectorAlign" ctrl:IconHost.Geometry="{StaticResource Icon.AlignRight}" ToolTip="Aligner à droite"
                                             IsChecked="{Binding Document.StyleAlignment, Converter={StaticResource EnumEquals}, ConverterParameter=Right}"/>
                            </UniformGrid>
                        </Border>

                        <DockPanel Style="{StaticResource Row}" Margin="0,8,0,0">
                            <TextBlock Text="Couleur" Style="{StaticResource RowLabel}"/>
                            <ctrl:ColorPickerButton HorizontalAlignment="Left" SelectedColor="{Binding Document.StyleTextColor}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Contenu -->
                <Border Style="{StaticResource InspectorCard}"
                        Visibility="{Binding Document.SelectedAnnotation.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Note|TextBox|TextEdit|Link|Stamp, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="CONTENU" Style="{StaticResource SectionHeader}"/>
                        <TextBox Style="{StaticResource MacTextBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="84"
                                 VerticalContentAlignment="Top"
                                 FontSize="12.5"
                                 Tag="Texte"
                                 Text="{Binding Document.SelectedAnnotation.Text, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding Document.SelectedAnnotation.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Note|TextBox|TextEdit, FallbackValue=Collapsed}"/>
                        <TextBox Style="{StaticResource MacTextBox}"
                                 FontSize="12.5"
                                 Tag="https://"
                                 Text="{Binding Document.SelectedAnnotation.Uri, UpdateSourceTrigger=LostFocus}"
                                 Visibility="{Binding Document.SelectedAnnotation.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Link, FallbackValue=Collapsed}"/>
                        <TextBox Style="{StaticResource MacTextBox}"
                                 FontSize="12.5"
                                 CharacterCasing="Upper"
                                 Text="{Binding Document.SelectedAnnotation.Label, UpdateSourceTrigger=LostFocus}"
                                 Visibility="{Binding Document.SelectedAnnotation.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Stamp, FallbackValue=Collapsed}"/>
                    </StackPanel>
                </Border>

                <!-- Position -->
                <Border Style="{StaticResource InspectorCard}">
                    <StackPanel>
                        <TextBlock Text="POSITION ET TAILLE" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="X" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SmallField}" HorizontalContentAlignment="Right" x:Name="FieldX"
                                     Text="{Binding Document.SelectedAnnotation.X, Converter={StaticResource Number}, ConverterParameter=1, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="3" Text="Y" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Column="4" Style="{StaticResource SmallField}" HorizontalContentAlignment="Right" x:Name="FieldY"
                                     Text="{Binding Document.SelectedAnnotation.Y, Converter={StaticResource Number}, ConverterParameter=1, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="2" Text="L" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource SmallField}" HorizontalContentAlignment="Right" x:Name="FieldWidth"
                                     IsEnabled="{Binding Document.SelectedAnnotation.CanResize, FallbackValue=False}"
                                     Text="{Binding Document.SelectedAnnotation.Width, Converter={StaticResource Number}, ConverterParameter=1, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="H" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource SmallField}" HorizontalContentAlignment="Right" x:Name="FieldHeight"
                                     IsEnabled="{Binding Document.SelectedAnnotation.CanResize, FallbackValue=False}"
                                     Text="{Binding Document.SelectedAnnotation.Height, Converter={StaticResource Number}, ConverterParameter=1, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <TextBlock Text="En points (1 pt ≈ 0,35 mm), depuis le coin supérieur gauche de la page." Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Organisation -->
                <Border Style="{StaticResource InspectorCard}">
                    <WrapPanel>
                        <Button Content="Dupliquer" Style="{StaticResource MacSmallButton}" Margin="0,0,6,6" Command="{Binding DuplicateCommand}"/>
                        <Button Content="Premier plan" Style="{StaticResource MacSmallButton}" Margin="0,0,6,6" Command="{Binding BringToFrontCommand}"/>
                        <Button Content="Arrière-plan" Style="{StaticResource MacSmallButton}" Margin="0,0,6,6" Command="{Binding SendToBackCommand}"/>
                        <Button Content="Supprimer" Style="{StaticResource MacSmallButton}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,6" Command="{Binding DeleteCommand}"/>
                    </WrapPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================
                 Style de l'outil courant (sans selection)
                 ============================================================ -->
            <StackPanel x:Name="ToolStylePanel" Visibility="Collapsed">
                <TextBlock x:Name="ToolStyleHeader" Style="{StaticResource SectionHeader}" Margin="24,4,12,6"/>
                <Border Style="{StaticResource InspectorCard}">
                    <StackPanel>
                        <DockPanel x:Name="ToolStrokeRow" Style="{StaticResource Row}" Margin="0">
                            <TextBlock Text="Couleur" Style="{StaticResource RowLabel}"/>
                            <ctrl:ColorPickerButton HorizontalAlignment="Left" SelectedColor="{Binding Document.StyleStrokeColor}"/>
                        </DockPanel>
                        <DockPanel x:Name="ToolTextColorRow" Style="{StaticResource Row}" Margin="0">
                            <TextBlock Text="Couleur" Style="{StaticResource RowLabel}"/>
                            <ctrl:ColorPickerButton HorizontalAlignment="Left" SelectedColor="{Binding Document.StyleTextColor}"/>
                        </DockPanel>
                        <DockPanel x:Name="ToolFillRow" Style="{StaticResource Row}">
                            <TextBlock Text="Remplissage" Style="{StaticResource RowLabel}"/>
                            <ctrl:ColorPickerButton HorizontalAlignment="Left" AllowTransparent="True" SelectedColor="{Binding Document.StyleFillColor}"/>
                        </DockPanel>
                        <DockPanel x:Name="ToolWidthRow" Style="{StaticResource Row}">
                            <TextBlock Text="Épaisseur" Style="{StaticResource RowLabel}"/>
                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding Document.StyleStrokeWidth, Converter={StaticResource Number}, ConverterParameter=1}"/>
                            <Slider Style="{StaticResource MacSlider}" Minimum="0.5" Maximum="24" Value="{Binding Document.StyleStrokeWidth}"/>
                        </DockPanel>
                        <DockPanel x:Name="ToolOpacityRow" Style="{StaticResource Row}">
                            <TextBlock Text="Opacité" Style="{StaticResource RowLabel}"/>
                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding Document.StyleOpacity, Converter={StaticResource Percent}}"/>
                            <Slider Style="{StaticResource MacSlider}" Minimum="0.05" Maximum="1" Value="{Binding Document.StyleOpacity}"/>
                        </DockPanel>
                        <DockPanel x:Name="ToolFontRow" Style="{StaticResource Row}">
                            <TextBlock Text="Police" Style="{StaticResource RowLabel}"/>
                            <ComboBox Style="{StaticResource MacComboBox}" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding Document.StyleFontFamily}"/>
                        </DockPanel>
                        <DockPanel x:Name="ToolFontSizeRow" Style="{StaticResource Row}">
                            <TextBlock Text="Taille" Style="{StaticResource RowLabel}"/>
                            <TextBox Style="{StaticResource SmallField}" Width="52" HorizontalAlignment="Left" HorizontalContentAlignment="Right"
                                     Text="{Binding Document.StyleFontSize, Converter={StaticResource Number}, ConverterParameter=1, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <TextBlock x:Name="ToolHint" Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================
                 Document
                 ============================================================ -->
            <StackPanel Visibility="{Binding Document.HasSelection, Converter={StaticResource BoolToVisibilityInverse}, FallbackValue=Collapsed}">

                <TextBlock Text="DOCUMENT" Style="{StaticResource SectionHeader}" Margin="24,4,12,6"/>

                <Border Style="{StaticResource InspectorCard}">
                    <StackPanel>
                        <DockPanel>
                            <Path DockPanel.Dock="Left"
                                  Data="{StaticResource Icon.Document}"
                                  Width="28" Height="28"
                                  Stretch="Uniform"
                                  Margin="0,0,10,0"
                                  Fill="{DynamicResource FolderIconBrush}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Document.DisplayName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding Document.FolderPath}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Document.FolderPath}"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource MacSeparator}" Margin="0,10,0,4"/>

                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Pages" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding Document.PageCount}" Style="{StaticResource ValueText}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Taille" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding Document.FileSizeLabel}" Style="{StaticResource ValueText}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Format" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding Document.VersionLabel}" Style="{StaticResource ValueText}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Annotations" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding Document.AnnotationCount}" Style="{StaticResource ValueText}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Formulaire" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="FormsText" Style="{StaticResource ValueText}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Proprietes -->
                <Border Style="{StaticResource InspectorCard}">
                    <StackPanel>
                        <TextBlock Text="PROPRIÉTÉS" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Titre" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox Style="{StaticResource SmallField}" Margin="0,3,0,7" Text="{Binding Document.MetaTitle, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Auteur" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox Style="{StaticResource SmallField}" Margin="0,3,0,7" Text="{Binding Document.MetaAuthor, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Sujet" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox Style="{StaticResource SmallField}" Margin="0,3,0,7" Text="{Binding Document.MetaSubject, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Mots-clés" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox Style="{StaticResource SmallField}" Margin="0,3,0,8" Text="{Binding Document.MetaKeywords, UpdateSourceTrigger=LostFocus}"/>

                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Créé le" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding Document.CreatedLabel}" Style="{StaticResource ValueText}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Modifié le" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding Document.ModifiedLabel}" Style="{StaticResource ValueText}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Créateur" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding Document.MetaCreator}" Style="{StaticResource ValueText}" ToolTip="{Binding Document.MetaCreator}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Producteur" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding Document.MetaProducer}" Style="{StaticResource ValueText}" ToolTip="{Binding Document.MetaProducer}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Securite -->
                <Border Style="{StaticResource InspectorCard}">
                    <StackPanel>
                        <TextBlock Text="SÉCURITÉ" Style="{StaticResource SectionHeader}"/>
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                  Fill="{DynamicResource IconBrush}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource Icon.Unlock}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Document.IsProtected}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.Lock}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding Document.ProtectionLabel}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Protéger…" Style="{StaticResource MacSmallButton}" Margin="0,0,6,0" Command="{Binding ProtectCommand}"/>
                            <Button Content="Retirer" Style="{StaticResource MacSmallButton}" Command="{Binding RemoveProtectionCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Page actuelle -->
                <Border Style="{StaticResource InspectorCard}">
                    <StackPanel>
                        <TextBlock Text="PAGE ACTUELLE" Style="{StaticResource SectionHeader}"/>
                        <DockPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Text="Page" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding Document.PageStatus}" Style="{StaticResource ValueText}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Format" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding Document.CurrentPage.SizeLabel}" Style="{StaticResource ValueText}"/>
                        </DockPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource ToolbarIconButton}" ctrl:IconHost.Geometry="{StaticResource Icon.RotateLeft}" ToolTip="Pivoter à gauche" Command="{Binding RotateLeftCommand}"/>
                            <Button Style="{StaticResource ToolbarIconButton}" ctrl:IconHost.Geometry="{StaticResource Icon.RotateRight}" ToolTip="Pivoter à droite" Command="{Binding RotateRightCommand}"/>
                            <Button Style="{StaticResource ToolbarIconButton}" ctrl:IconHost.Geometry="{StaticResource Icon.Duplicate}" ToolTip="Dupliquer la page" Command="{Binding DuplicatePagesCommand}"/>
                            <Button Style="{StaticResource ToolbarIconButton}" ctrl:IconHost.Geometry="{StaticResource Icon.Crop}" ToolTip="Recadrer les marges" Command="{Binding CropPagesCommand}"/>
                            <Button Style="{StaticResource ToolbarIconButton}" ctrl:IconHost.Geometry="{StaticResource Icon.Trash}" ToolTip="Supprimer la page" Command="{Binding DeletePagesCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Outils du document -->
                <Border Style="{StaticResource InspectorCard}">
                    <StackPanel>
                        <TextBlock Text="OUTILS" Style="{StaticResource SectionHeader}"/>
                        <WrapPanel>
                            <Button Content="Filigrane…" Style="{StaticResource MacSmallButton}" Margin="0,0,6,6" Command="{Binding WatermarkCommand}"/>
                            <Button Content="Numérotation…" Style="{StaticResource MacSmallButton}" Margin="0,0,6,6" Command="{Binding HeaderFooterCommand}"/>
                            <Button Content="OCR…" Style="{StaticResource MacSmallButton}" Margin="0,0,6,6" Command="{Binding OcrCommand}"/>
                            <Button Content="Diviser…" Style="{StaticResource MacSmallButton}" Margin="0,0,6,6" Command="{Binding SplitCommand}"/>
                            <Button Content="Exporter en images…" Style="{StaticResource MacSmallButton}" Margin="0,0,6,6" Command="{Binding ExportImagesCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
